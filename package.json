{
  "name": "vue-datatables-182",
  "version": "2.0.0-alpha.0",
  "description": "Datatables component for Vue 3",
  "license": "MIT",
  "homepage": "https://github.com/heavenlybilly/vue-datatables-182",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npx eslint ./ .storybook --ext .ts,.vue,.js,.cjs,.mjs --ignore-path .eslintignore",
    "lint:fix": "npx eslint ./ .storybook --ext .ts,.vue,.js,.cjs,.mjs --ignore-path .eslintignore --fix",
    "stylelint": "stylelint \"**/*.{scss,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{scss,vue}\" --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "check:types": "npx vue-tsc --noEmit",
    "check:code": "npm run check:types && npm run test && npm run lint && npm run stylelint",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "benchmark:local": "vitest run --config config/benchmark.ts",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "test:storybook": "vitest run --config config/storybook-tests.ts",
    "test:release": "node --test scripts/release-policy.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/server-renderer": "3.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.63.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.3.3",
    "rollup": "^4.27.4",
    "rollup-plugin-dts": "^6.1.1",
    "sass": "^1.81.0",
    "semver": "^7.8.5",
    "storybook": "^10.6.1",
    "stylelint": "^16.10.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.9.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.4",
    "vite-svg-loader": "^4.0.0",
    "vitest": "^5.0.3",
    "vue": "3.5.0",
    "vue-tsc": "^2.0.29"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "keywords": [
    "vue",
    "datatables",
    "component",
    "vue-component",
    "vue3",
    "vue-datatables"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/heavenlybilly/vue-datatables-182"
  },
  "bugs": {
    "url": "https://github.com/heavenlybilly/vue-datatables-182/issues"
  },
  "author": {
    "name": "Sergei Spitsin",
    "email": "heavenlybilly@gmail.com"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
